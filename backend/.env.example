# Comma-separated Vercel URL(s), plus http://localhost:5173 for local development.
FRONTEND_URL=https://site-score-sable.vercel.app,http://localhost:5173

# Reserved for Stage 4 persistence. Use the Supabase publishable key only for public client access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Server-side persistence. Store this only in Render secrets. Use Supabase's
# IPv4-compatible pooler URL because Render may not have IPv6 connectivity.
DATABASE_URL=postgresql://postgres.your-project-ref:your-rotated-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Resend server-side email delivery. The From address must be verified in Resend.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=SiteScore <reports@your-verified-domain.com>

# Public Render URL used in copied share links and OG image URLs.
PUBLIC_API_URL=https://your-service.onrender.com
