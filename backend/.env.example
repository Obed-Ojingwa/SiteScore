# Comma-separated Vercel URL(s), plus http://localhost:5173 for local development.
FRONTEND_URL=https://site-score-sable.vercel.app,http://localhost:5173

# Reserved for Stage 4 persistence. Use the Supabase publishable key only for public client access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Reserved for Stage 4 server-side persistence. Store this only in Render secrets.
DATABASE_URL=postgresql://postgres:your-rotated-password@db.your-project.supabase.co:5432/postgres
